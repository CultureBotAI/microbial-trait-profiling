*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.coverage
coverage.xml

data/raw/*.csv
# download_provenance.json is deliberately NOT ignored (#115): it records which
# BugSigDB release a checkout was built from, and that has to survive into version
# control or the vintage is only recoverable from the machine that ran the download.
data/studies/*.yaml
data/derived/*
!data/derived/.gitkeep
# Reviewed native evidence and compact calibration artifacts (#551).
!data/derived/trait_profile_paired_contrast_trait_stats_pooled.tsv
!data/derived/integrated_evidence/
data/derived/integrated_evidence/*
!data/derived/integrated_evidence/integrated_evidence_method_results.tsv
!data/derived/integrated_evidence/integrated_evidence.md
!data/derived/integrated_evidence/integrated_evidence_features.tsv
!data/derived/integrated_evidence/integrated_evidence_families.tsv
!data/derived/integrated_evidence/integrated_evidence_assessments.tsv
!data/derived/integrated_evidence/integrated_evidence_provenance.json
!data/derived/ora_calibration/
data/derived/ora_calibration/*
!data/derived/ora_calibration/calibration_summary.json
!data/derived/ora_calibration/calibration_replicates.tsv
!data/derived/ora_calibration/calibration_ecdf.tsv
# Cited summary tables opted in per path (CONTRIBUTING.md, "Generated outputs on main").
!data/derived/calibration/
data/derived/calibration/*
!data/derived/calibration/composition/
data/derived/calibration/composition/*
!data/derived/calibration/composition/composition_calibration_summary.json
!data/derived/calibration/composition/composition_calibration_summary.tsv
!data/derived/calibration/composition/composition_calibration_replicates.tsv
!data/derived/calibration/composition/table1_composition_calibration.tsv
!data/derived/trait_coupling_loto_matrix.tsv
!data/derived/trait_coupling_lco_summary.tsv
