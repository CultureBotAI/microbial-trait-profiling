.venv/
.mypy_cache/
.pytest_cache/
.pytest-tmp/
.ruff_cache/
.tmp/
pytest-cache-files-*/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.coverage
coverage.xml

data/raw/*.csv
# download_provenance.json is deliberately NOT ignored (#115): it records which
# BugSigDB release a checkout was built from, and that has to survive into version
# control or the vintage is only recoverable from the machine that ran the download.
data/studies/*.yaml
data/derived/*
!data/derived/.gitkeep
# Cited summary tables opted in per path (CONTRIBUTING.md, "Generated outputs on main").
!data/derived/calibration/
data/derived/calibration/*
!data/derived/calibration/composition/
data/derived/calibration/composition/*
!data/derived/calibration/composition/composition_calibration_summary.json
!data/derived/calibration/composition/composition_calibration_summary.tsv
!data/derived/calibration/composition/composition_calibration_replicates.tsv
!data/derived/calibration/composition/table1_composition_calibration.tsv
!data/derived/trait_coupling_loto_matrix.tsv
!data/derived/trait_coupling_lco_summary.tsv
!data/derived/trait_coupling_report.txt
!data/derived/density_adjustment/
data/derived/density_adjustment/*
!data/derived/density_adjustment/ontology_redundancy_pairs.tsv
!data/derived/density_adjustment/ontology_redundancy_summary.tsv
!data/derived/density_adjustment/ontology_collapsing_comparison.tsv
data/benchmarks/*
data/kg-microbe/*.tsv
# Regenerated by `just cellulose-decr-figures`; images stay out of git outside
# trait-visualization/ (CONTRIBUTING.md, "Generated outputs on main"; #560).
data/analysis/cellulose_decr/figures/
data/analysis/cellulose_decr/figures_graphical/
data/analysis/cellulose_decr/cellulose_decr_figures.pdf
data/analysis/cellulose_decr/cellulose_decr_graphical_figures.pdf
logs/

.env
.DS_Store
